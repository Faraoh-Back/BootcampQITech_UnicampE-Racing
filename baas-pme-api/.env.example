# ─────────────────────────────────────────────────────────────
# Exemplo de configuração — Bootcamp QI Tech
#
# VOCÊ NÃO PRECISA DISTO PRA COMEÇAR. O "docker compose up" sobe
# com todos os valores abaixo já preenchidos, sem criar arquivo
# nenhum.
#
# Este arquivo serve pra quando você quiser TROCAR alguma coisa —
# uma porta ocupada, o token, o banco. Aí sim:
#   cp .env.example .env
# e edite o .env. O que estiver nele ganha do valor padrão.
#
# O arquivo .env é SEU, fica só na sua máquina e nunca vai pro Git
# (olha lá no .gitignore). Este .env.example, sim, vai pro Git —
# por isso ele só tem valor de mentirinha, nunca senha de verdade.
#
# Essa é a regra nº 1 de configuração: senha não mora no código.
# Ela mora no ambiente, e o código só pergunta "qual é?".
# ─────────────────────────────────────────────────────────────

# Em qual ambiente a aplicação acha que está rodando.
# Vale "local", "test" ou "production" — muda o NÍVEL do log: em
# "local" e "test" as linhas de DEBUG aparecem; em "production", só
# de INFO pra cima. O formato da linha é o mesmo nos três.
APP_ENV=local

# Nome do serviço. Aparece no log e na rota raiz da API.
SERVICE_NAME=bootcamp-api

# Endereço completo do banco, no formato:
#   postgresql+psycopg2://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Rodando com "docker compose up", o compose troca o HOST por "db"
# automaticamente (é o nome do serviço do Postgres) — ou seja, esta
# linha aqui NÃO vale lá dentro.
# Ela vale pra quem roda alguma coisa direto na própria máquina.
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp

# Senha simples que protege os endpoints internos da API.
# Quem chama precisa mandar o header:  INTERNAL-TOKEN: default_token
INTERNAL_TOKEN=default_token

# Segredo de assinatura dos JWTs de usuário. Em produção use um valor longo,
# aleatório e exclusivo por ambiente; nunca reutilize o INTERNAL_TOKEN.
JWT_SECRET=change-this-local-jwt-secret-before-production
JWT_ACCESS_TOKEN_MINUTES=15
JWT_SESSION_MAX_HOURS=8

# Onde os testes procuram a API, quando rodados fora do Docker.
SERVER_LOCALHOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
# A API de boletos (o connector)
#
# É o serviço de FORA que este projeto chama pra emitir cobrança —
# veja src/connectors/. Não existe uma API de boletos rodando na sua
# máquina, e tudo bem: quem faz o papel dela é um mock server (assunto
# do sábado 4). Estes valores dizem ao connector onde ela "está".
# ─────────────────────────────────────────────────────────────

# Onde a API de boletos atende (MockServer no docker-compose atende em http://mock:1080).
BANKSLIP_API_URL=http://mock:1080
# `requests` recebe tempos separados: conexão curta e leitura suficiente para
# o provedor responder. Não reutilize um único timeout para os dois casos.
BANKSLIP_API_CONNECT_TIMEOUT_SECONDS=1
BANKSLIP_API_READ_TIMEOUT_SECONDS=5

# A API do Banco Central (consulta aos índices IPCA e IGPM)
CENTRAL_BANK_API_URL=http://mock:1080
CENTRAL_BANK_API_CONNECT_TIMEOUT_SECONDS=1
CENTRAL_BANK_API_READ_TIMEOUT_SECONDS=5

# Limites aplicados localmente em toda transação PostgreSQL e orçamento máximo
# dos pontos bloqueantes da requisição. Após timeout de operação financeira,
# repita exclusivamente com a mesma Idempotency-Key.
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_SECONDS=15
# Retentativa limitada apenas para deadlock/serialização; nunca para regra de negócio.
DATABASE_TRANSIENT_RETRY_MAX_ATTEMPTS=2
DATABASE_TRANSIENT_RETRY_BASE_DELAY_MS=25

# Notificações assíncronas: o worker publica a outbox após o commit usando o
# event_key como Idempotency-Key. Em produção, a URL deve ser do serviço de
# notificações; o padrão aponta para o MockServer local.
NOTIFICATION_WEBHOOK_URL=http://mock:1080/notifications
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=30
OUTBOX_RETRY_BASE_SECONDS=5

# ─────────────────────────────────────────────────────────────
# Parâmetros e Regras de Negócio (D1 e D8)
# ─────────────────────────────────────────────────────────────
# Tarifa cobrada na conta de origem por transferência realizada (em centavos: 100 = R$ 1,00)
TRANSFER_FEE_CENTS=100

# Taxa percentual cobrada na antecipação de recebíveis (3 = 3%)
ADVANCE_FEE_PERCENT=3

# Janela noturna e limite de segurança (em centavos: 100000 = R$ 1.000,00)
NIGHT_START=20:00
NIGHT_END=06:00
NIGHT_LIMIT_CENTS=100000
TIMEZONE=America/Sao_Paulo
# Somente para testes determinísticos; deixe vazio em uso normal para usar o relógio real.
NIGHT_TIME_OVERRIDE=

# ─────────────────────────────────────────────────────────────
# Portas — mexa aqui se alguma já estiver ocupada na sua máquina
# ─────────────────────────────────────────────────────────────
# Em qual porta da SUA máquina a API vai atender (http://localhost:3000).
#API_PORT=3001

# Em qual porta da SUA máquina o banco vai atender (http://localhost:5432).
#DB_PORT=5433

# Em qual porta da SUA máquina o MockServer vai atender (http://localhost:1080).
#MOCK_PORT=1081
